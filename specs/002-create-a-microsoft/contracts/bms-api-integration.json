{
  "openapi": "3.0.0",
  "info": {
    "title": "BMS Agent API Integration",
    "version": "1.0.0",
    "description": "Contract for n8n workflow to BMS Agent API endpoints"
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "BMS Agent API on RunPod"
    }
  ],
  "paths": {
    "/api/v1/ask": {
      "post": {
        "summary": "Ask question with LLM-generated answer",
        "description": "Get direct answer with citations (used when intent=ASK)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Answer generated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AskResponse"
                }
              }
            }
          },
          "500": {
            "description": "BMS API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Service unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/search/semantic": {
      "post": {
        "summary": "Semantic document search",
        "description": "Find relevant documents (used when intent=SEARCH)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Search results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/search/hybrid": {
      "post": {
        "summary": "Hybrid search (semantic + keyword)",
        "description": "Alternative to semantic search with keyword matching",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HybridSearchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Hybrid search results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/documents/upload": {
      "post": {
        "summary": "Upload document (synchronous)",
        "description": "Upload and index document immediately",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/UploadRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Document processed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid file type or size",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/documents/upload/async": {
      "post": {
        "summary": "Upload document (asynchronous)",
        "description": "Upload document for background processing",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/UploadRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Document queued for processing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AsyncUploadResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/embeddings": {
      "post": {
        "summary": "Generate query embeddings",
        "description": "Get 768-dimensional embedding vector for similarity detection",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["text"],
                "properties": {
                  "text": {
                    "type": "string",
                    "maxLength": 1000,
                    "description": "Query text to embed"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Embedding generated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "embedding": {
                      "type": "array",
                      "items": {"type": "number"},
                      "minItems": 768,
                      "maxItems": 768,
                      "description": "768-dimensional embedding vector"
                    },
                    "model": {
                      "type": "string",
                      "example": "sentence-transformers/all-mpnet-base-v2"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/documents/status/{job_id}": {
      "get": {
        "summary": "Get upload status",
        "description": "Check document processing status (async uploads)",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Job status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobStatus"
                }
              }
            }
          },
          "404": {
            "description": "Job not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AskRequest": {
        "type": "object",
        "required": ["query"],
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 1000,
            "description": "User's question"
          },
          "max_chunks": {
            "type": "integer",
            "default": 5,
            "minimum": 1,
            "maximum": 10,
            "description": "Max context chunks for answer"
          },
          "include_citations": {
            "type": "boolean",
            "default": true,
            "description": "Include source citations"
          },
          "temperature": {
            "type": "number",
            "default": 0.7,
            "minimum": 0.0,
            "maximum": 1.0
          },
          "min_score": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "description": "Minimum relevance score"
          }
        }
      },
      "AskResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "success"
          },
          "query": {
            "type": "string"
          },
          "answer": {
            "type": "string",
            "description": "Generated answer"
          },
          "citations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Citation"
            }
          },
          "confidence": {
            "type": "number",
            "description": "Answer confidence (0.0-1.0)"
          },
          "generation_time_ms": {
            "type": "integer"
          }
        }
      },
      "SearchRequest": {
        "type": "object",
        "required": ["query"],
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 1000
          },
          "limit": {
            "type": "integer",
            "default": 5,
            "minimum": 1,
            "maximum": 10
          },
          "min_score": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "description": "Minimum relevance threshold"
          },
          "min_quality": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "description": "Minimum RAGAS quality score"
          }
        }
      },
      "HybridSearchRequest": {
        "allOf": [
          {
            "$ref": "#/components/schemas/SearchRequest"
          },
          {
            "type": "object",
            "properties": {
              "vector_weight": {
                "type": "number",
                "default": 0.6,
                "minimum": 0.0,
                "maximum": 1.0
              },
              "keyword_weight": {
                "type": "number",
                "default": 0.4,
                "minimum": 0.0,
                "maximum": 1.0
              }
            }
          }
        ]
      },
      "SearchResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "success"
          },
          "query": {
            "type": "string"
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SearchResult"
            }
          },
          "search_metadata": {
            "type": "object",
            "properties": {
              "total_results": {
                "type": "integer"
              },
              "search_time_ms": {
                "type": "integer"
              }
            }
          }
        }
      },
      "SearchResult": {
        "type": "object",
        "properties": {
          "chunk_id": {
            "type": "string"
          },
          "document_name": {
            "type": "string"
          },
          "content": {
            "type": "string",
            "maxLength": 1500
          },
          "score": {
            "type": "number",
            "description": "Relevance score (0.0-1.0)"
          },
          "metadata": {
            "type": "object",
            "properties": {
              "quality_score": {
                "type": "number"
              },
              "document_url": {
                "type": "string"
              }
            }
          }
        }
      },
      "Citation": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer"
          },
          "chunk_id": {
            "type": "string"
          },
          "document_name": {
            "type": "string"
          },
          "preview": {
            "type": "string",
            "maxLength": 500
          },
          "relevance_score": {
            "type": "number"
          }
        }
      },
      "UploadRequest": {
        "type": "object",
        "required": ["file"],
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "description": "Document file (PDF, CSV, XLSX, TXT, MD, DOCX, PPTX)"
          },
          "profile": {
            "type": "string",
            "enum": ["railway", "technical", "general"],
            "default": "railway",
            "description": "Processing profile"
          }
        }
      },
      "UploadResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "success"
          },
          "document_id": {
            "type": "string",
            "format": "uuid"
          },
          "file_name": {
            "type": "string"
          },
          "processing_result": {
            "type": "object",
            "properties": {
              "chunks_created": {
                "type": "integer"
              },
              "quality_score": {
                "type": "number"
              },
              "processing_time_ms": {
                "type": "integer"
              }
            }
          }
        }
      },
      "AsyncUploadResponse": {
        "type": "object",
        "properties": {
          "job_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "example": "queued"
          },
          "status_url": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "JobStatus": {
        "type": "object",
        "properties": {
          "job_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["queued", "processing", "completed", "failed"]
          },
          "progress": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "result": {
            "type": "object",
            "description": "Present when status=completed"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "error"
          },
          "error": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    }
  }
}
