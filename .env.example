# BMS Agent - Railway Documentation RAG System
# Environment Configuration Template
# Copy this file to .env and update with your values

# ============================================================================
# CORE SETTINGS
# ============================================================================

# Optional API key for authenticated access (leave empty for anonymous access)
BMS_API_KEY=

# Qdrant Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=nomad_bms_documents

# ============================================================================
# EMBEDDING CONFIGURATION
# ============================================================================

# Choose embedding provider: sentence-transformers or ollama
# Option 1: sentence-transformers (default, faster, 768d)
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2

# Option 2: Ollama (uncomment to use, requires Ollama installed, 1024d)
# EMBEDDING_MODEL=snowflake-arctic-embed2
# EMBEDDING_URL=http://localhost:11434/api/embeddings

# ============================================================================
# PROCESSING CONFIGURATION
# ============================================================================

# Processing profile: RAILWAY, TECHNICAL, or GENERAL
BMS_PROCESSING_PROFILE=RAILWAY

# Chunking parameters
BMS_CHUNK_SIZE=1500
BMS_CHILD_CHUNK_SIZE=500
BMS_CHUNK_OVERLAP=200

# Quality validation
BMS_ENABLE_QUALITY_VALIDATION=true
BMS_QUALITY_THRESHOLD=85.0

# Search configuration
BMS_ENABLE_HYBRID_SEARCH=true
BMS_DEFAULT_ALPHA=0.5

# ============================================================================
# FILE UPLOAD SETTINGS
# ============================================================================

# Maximum upload file size in bytes (default: 100MB)
BMS_UPLOAD_MAX_BYTES=104857600

# Embedding batch size (reduce if out of memory)
BMS_EMBEDDING_BATCH_SIZE=32

# ============================================================================
# LOGGING & OBSERVABILITY
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file paths
LOG_DIR=/workspace/logs

# ============================================================================
# PERSISTENCE PATHS (RunPod POD Environment)
# ============================================================================

# CRITICAL: All paths must be under /workspace for persistence
QDRANT_STORAGE_PATH=/workspace/qdrant-data
UPLOAD_FILES_PATH=/workspace/bms-agent/upload-files
LOGS_PATH=/workspace/logs

# ============================================================================
# PERFORMANCE TUNING
# ============================================================================

# API worker processes (default: 1, increase for production)
WORKERS=1

# Request timeout in seconds
REQUEST_TIMEOUT=120

# ============================================================================
# OPTIONAL: OPENWEBUI INTEGRATION
# ============================================================================

# OpenWebUI URL (for CORS configuration)
OPENWEBUI_URL=http://localhost:8080

# ============================================================================
# OPTIONAL: n8n INTEGRATION
# ============================================================================

# n8n webhook URL (if using n8n workflows)
# N8N_WEBHOOK_URL=http://localhost:5678/webhook/bms-search
