# MS Teams Bot Configuration
# Bot Framework credentials from https://dev.botframework.com
BOT_APP_ID=your-bot-app-id-here
BOT_APP_PASSWORD=your-bot-app-password-here

# MS Teams Webhook URL (n8n webhook endpoint)
TEAMS_WEBHOOK_URL=https://your-n8n-instance/webhook/teams

# BMS Agent API Configuration
BMS_API_URL=http://localhost:8000
BMS_API_TIMEOUT=2500  # milliseconds (2.5s max for 3s total SLA)

# Ollama Configuration (for Mistral Nemo LLM)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral-nemo:12b-instruct

# Redis Configuration (conversation storage)
REDIS_URL=redis://localhost:6379
REDIS_TTL=604800  # 7 days in seconds

# File Paths
WHITELIST_PATH=/workspace/002-n8n/config/whitelist.json

# Performance Tuning
MAX_CONCURRENT_REQUESTS=20
RESPONSE_TIMEOUT_MS=3000  # 3 second total response time SLA
