# n8n Environment Configuration
# Source this file before starting n8n: source config/n8n.env

# Core Settings
export N8N_USER_FOLDER=/workspace/n8n
export N8N_HOST=0.0.0.0
export N8N_PORT=5678
export N8N_PROTOCOL=http
export WEBHOOK_URL=http://localhost:5678/

# Push Backend
export N8N_PUSH_BACKEND=websocket

# Privacy
export N8N_DIAGNOSTICS_ENABLED=false

# Timezone
export GENERIC_TIMEZONE=UTC

# Security (recommended settings from n8n)
export N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
export N8N_BLOCK_ENV_ACCESS_IN_NODE=false
export N8N_GIT_NODE_DISABLE_BARE_REPOS=true

# Performance (recommended settings)
export DB_SQLITE_POOL_SIZE=5
export N8N_RUNNERS_ENABLED=true

# Logging
export N8N_LOG_LEVEL=info
export N8N_LOG_OUTPUT=console

echo "✓ n8n environment variables loaded"
echo "  User Folder: $N8N_USER_FOLDER"
echo "  Port: $N8N_PORT"
echo "  Webhook URL: $WEBHOOK_URL"
