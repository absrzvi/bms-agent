    {
      "parameters": {
        "jsCode": "// Format the API response for output\nconst items = $input.all();\nconst outputs = [];\n\nfor (const item of items) {\n  const apiResponse = item.json;\n  \n  outputs.push({\n    json: {\n      answer: apiResponse.answer || apiResponse.data?.answer || \"\",\n      citations: apiResponse.citations || apiResponse.data?.citations || [],\n      confidence: apiResponse.confidence || apiResponse.data?.confidence || 0,\n      metadata: {\n        timestamp: new Date().toISOString(),\n        success: true\n      }\n    }\n  });\n}\n\nreturn outputs;"
